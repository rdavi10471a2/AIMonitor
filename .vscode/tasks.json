{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/AIMonitor.slnx"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build cli",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AIMonitor.Cli/AIMonitor.Cli.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build bridge",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AIMonitor.Bridge/AIMonitor.Bridge.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build mcp",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AIMonitor.McpServer/AIMonitor.McpServer.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build app",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/AIMonitor.App/AIMonitor.App.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test all",
      "dependsOn": [
        "test core",
        "test data",
        "test indexing",
        "test logging",
        "test msbuild",
        "test workflow",
        "test integration"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "test core",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/unit/AIMonitor.Core.Tests/AIMonitor.Core.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "test data",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/unit/AIMonitor.Data.Tests/AIMonitor.Data.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "test indexing",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/unit/AIMonitor.Indexing.Tests/AIMonitor.Indexing.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "test logging",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/unit/AIMonitor.Logging.Tests/AIMonitor.Logging.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "test msbuild",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/unit/AIMonitor.MSBuild.Tests/AIMonitor.MSBuild.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "test workflow",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/unit/AIMonitor.Workflow.Tests/AIMonitor.Workflow.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "test integration",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/integration/AIMonitor.Integration.Tests/AIMonitor.Integration.Tests.csproj"
      ],
      "group": "test",
      "problemMatcher": "$msCompile",
      "dependsOn": "build cli"
    },
    {
      "label": "run app",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/AIMonitor.App/AIMonitor.App.csproj"
      ],
      "dependsOn": "build app",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "cli status",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/AIMonitor.Cli/AIMonitor.Cli.csproj",
        "--",
        "status",
        "--repo-root",
        "${workspaceFolder}",
        "--config",
        "${workspaceFolder}/config/appsettings.json"
      ],
      "dependsOn": "build cli",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "cli index rebuild",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/AIMonitor.Cli/AIMonitor.Cli.csproj",
        "--",
        "index",
        "rebuild",
        "--repo-root",
        "${workspaceFolder}",
        "--config",
        "${workspaceFolder}/config/appsettings.json"
      ],
      "dependsOn": "build cli",
      "problemMatcher": "$msCompile"
    }
  ]
}
